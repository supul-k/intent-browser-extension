{
  "manifest_version": 3,
  "name": "Intent - Mindful Browsing",
  "version": "1.0.0",
  "description": "Regain control of your digital life. Set intentions, track focus, and browse mindfully.",
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "idle"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/ic_eye.svg",
      "48": "icons/pdf-icon.svg",
      "128": "icons/settings.svg"
    }
  },
  "options_page": "options/options.html",
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"]
    }
  ],
  "icons": {
    "16": "icons/ic_eye.svg",
    "48": "icons/pdf-icon.svg",
    "128": "icons/settings.svg"
  }
}